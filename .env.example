# ============================================================================
# LUMEN — environment template. Copy to `.env` at the repository root and fill
# in real values:   cp .env.example .env
#
# The `.env` at the repo root is the SINGLE canonical config file. The backend
# (api/lumen/config.py) and the frontend (client/vite.config.js) both read it;
# only VITE_* variables are ever exposed to the browser bundle.
#
# Placeholder values only — never commit real credentials.
# ============================================================================

# ── Backend: application ────────────────────────────────────────────────────
# APP_ENV: development | production | test
APP_ENV=development
DEBUG=false

# ── Backend: database (REQUIRED — the app fails fast if unset) ─────────────
# Full SQLAlchemy URL. A bare postgresql:// URL is auto-normalised to the
# psycopg3 dialect (postgresql+psycopg://).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Optional dedicated test database. When unset, Postgres-backed tests use
# DATABASE_URL. Leave commented unless you run a separate test DB.
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME_test

# ── Docker Compose: PostgreSQL provisioning (compose-only) ─────────────────
# Compose uses these to create the DB container AND to compose DATABASE_URL for
# the backend service (see docker-compose.yml). Outside Docker they are unused;
# local/non-Docker runs rely on DATABASE_URL above. Keep them consistent.
POSTGRES_USER=lumen
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lumen

# ── Backend: CORS (comma-separated list of allowed browser origins) ────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Backend: Neo4j (OPTIONAL — legacy reference graph service, ADR-001) ────
# The production graph runs in-process; leave disabled unless you are running
# the optional legacy Neo4j service. Only read when NEO4J_ENABLED=true.
NEO4J_ENABLED=false
# NEO4J_URI=bolt://HOST:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=CHANGE_ME

# ── Frontend (browser-exposed — MUST be prefixed VITE_) ────────────────────
# Base URL the SPA calls. In dev, Vite proxies /api to the backend.
VITE_API_BASE_URL=/api
# Optional dev toggle: set to 'false' to force real network calls instead of
# the in-browser mock session/data. Unset = mocks enabled (dev default).
# VITE_USE_MOCKS=false
